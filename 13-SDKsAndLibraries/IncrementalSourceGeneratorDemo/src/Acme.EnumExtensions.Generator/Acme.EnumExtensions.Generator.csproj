<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 e OBRIGATORIO para gerador de codigo: o compilador carrega o
       analisador no processo dele, e esse processo pode ser qualquer versao do .NET.
       Um gerador em net10.0 simplesmente nao e carregado, e o sintoma e "nao gera nada"
       sem nenhuma mensagem de erro. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rastreamento de regras do analisador: exigido por RS2008. -->
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets=all: o consumidor nao deve receber Roslyn como dependencia. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
