<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Feed local para este exemplo. <clear /> evita que a ordem de fontes herdada da
       maquina interfira no resultado. O nuget.org continua disponivel porque o
       consumidor precisa dos pacotes do SDK. -->
  <packageSources>
    <clear />
    <add key="acme-local" value="local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
